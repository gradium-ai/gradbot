# Keenable realtime web search (optional: leave empty for the keyless public endpoint)
KEENABLE_API_KEY=

# Gradium voice (speech-to-text + text-to-speech)
GRADIUM_API_KEY=

# Conversational LLM (OpenAI-compatible). Must support tool/function calling.
# Example: OpenRouter with a tool-capable model.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
