# Copy to .env and fill in. Keys stay server-side; the browser never sees them.
GRADIUM_API_KEY=gd_...
OPENAI_API_KEY=sk-...

# Optional overrides
# GRADIUM_API_URL=https://api.gradium.ai
# GRADIUM_VOICE_ID=YTpq7expH9539ERJ
# OPENAI_MODEL=gpt-5.6-sol            # flagship: escalation for pile search / checks
# OPENAI_FAST_MODEL=gpt-5.6-luna      # cheap tier: first pass everywhere
# OPENAI_FIND_EFFORT=low              # pile-search escalation effort; raise for accuracy
# OPENAI_PARSE_EFFORT=low             # manual parsing effort; bump to high for a careful re-parse
# PARSE_CONCURRENCY=12                # parse fan-out (pages in flight)
# PILE_IMAGE_DETAIL=high              # pile-crop detail for the fast tier; "low"
#                                     # is cheaper but misses bricks and breaks
#                                     # the pinpoint bounding boxes

# Voice session (gradbot). LLM_* defaults are derived from the OpenAI vars
# above; set them only to point the conversational agent elsewhere.
# LLM_MODEL=gpt-5.6-luna              # conversational agent (routes tools, relays results)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_EXTRA_CONFIG={"reasoning_effort": "none"}  # MUST stay "none" on gpt-5.6:
#                                     # chat completions 400s on tools+reasoning,
#                                     # and a voice loop shouldn't reason anyway
# GRADBOT_FLUSH_S=0.3                 # STT flush window: silence gradbot waits
#                                     # after you stop talking before the agent
#                                     # answers. SDK default 0.5; raise if the
#                                     # end of sentences gets clipped.
# GRADIUM_VOICE_ID_FR=...             # per-language voice overrides for the
# GRADIUM_VOICE_ID_ES=...             # language picker; unset = first flagship
# GRADIUM_VOICE_ID_DE=...             # voice for that language
# GRADIUM_VOICE_ID_PT=...
